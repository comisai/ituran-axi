# Copy to test/live/.env.prod (or .env.qa) and fill in. Those files are gitignored.
# Run: node --env-file=test/live/.env.prod test/live/ituran-live.mjs
#
# The API root. Production is https://api.ituran.com/api/v2; QA is https://api-qa.ituran.com/api/v2.
ITURAN_GLOBAL_BASE_URL=https://api.ituran.com/api/v2
# A service account without two-step sign-in.
ITURAN_USERNAME=
ITURAN_PASSWORD=
# Optional. The identity root; derived from the API root (/api/v2 -> /api/v1) when unset.
# ITURAN_IDENTITY_BASE_URL=
# Optional. A bearer token, or inside Comis the Gate's placeholder. When set, the
# test signs in with it and sends no password grant.
# ITURAN_TOKEN=
