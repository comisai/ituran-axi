          "always_on": "Always on",
          "time_filtering": "Times",
          "alert_contacts": "Who is told",
          "license_plates": "Vehicles",
          "vehicle_group_ids": "Vehicle groups",
          "speed_exceeds": "Speed above",
          "place_alert": "Place",
          "contact_id": "Contact",
          "is_send_push": "Push",
          "is_send_sms": "SMS",
          "is_send_email": "Email",
          "vehicle_group_id": "Group",
