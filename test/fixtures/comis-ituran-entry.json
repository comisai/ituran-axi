{
  "title": "Ituran",
  "key_help": "the username and password of an Ituran service account without two-step sign-in; the Gate signs in with them and keeps the token",
  "hosts": ["api.ituran.com"],
  "credential": {
    "secret": "ituran",
    "exchange": "ituran",
    "inject": "bearer",
    "match": [
      "GET /api/v2/users/me",
      "GET /api/v2/vehicles",
      "GET /api/v2/vehicles/{plate}",
      "GET /api/v2/vehicles/{plate}/{location|driver|over-speeding|alerts}",
      "POST /api/v2/vehicles/search",
      "GET /api/v2/drivers",
      "GET /api/v2/drivers/{driver}",
      "POST /api/v2/drivers/search",
      "GET /api/v2/places",
      "GET /api/v2/places/{place}/vehicles",
      "GET /api/v2/vehicle-groups",
      "GET /api/v2/vehicle-groups/{group}",
      "GET /api/v2/alerts",
      "GET /api/v2/alerts/{alert}",
      "GET /api/v2/event-definitions",
      "GET /api/v2/event-definitions/types",
      "GET /api/v2/events",
      "GET /api/v2/events/{over-speeding|stats}",
      "GET /api/v2/events/{event}/vehicles",
      "GET /api/v2/trips",
      "GET /api/v2/trips/{trip}",
      "GET /api/v2/trips/{trip}/{points|safety|over-speeding}",
      "POST /api/v2/trips/totals",
      "POST /api/v2/virtual-odometer",
      "POST /api/v2/diagnostics",
      "POST /api/v2/diagnostics/history",
      "POST /api/v2/reports/bi/{daily|periodic|idle_percentage}/{drivers|vehicles}",
      "POST /api/v2/reports/{events-report|engine-and-switch-activity|speed-report|full-report|diagnostics-report|heat-map}",
      "GET /api/v2/safety/groups",
      "POST /api/v2/safety/{vehicles|drivers|totals|periodic}",
      "POST /api/v2/safety/ubi/{vehicles|drivers}",
      "GET /api/v2/bi/groups",
      "GET /api/v2/info/{ituran-service-centers|distributor-service-centers}",
      "GET /api/v2/exports/status",
      "GET /api/v2/exports/status/{export}",
      "GET /api/v2/commands",
      "GET /api/advanced/v1/alerts",
      "GET /api/advanced/v1/relations/entities",
      "GET /api/v1/temperatures/{current|report|exceptions}",
      "GET /api/v1/temperatures/exceptions/stats/perday",
      "GET /api/v1/maintenance/{treatments|type}",
      "GET /api/v1/vehicles/maintenance",
      "GET /api/v1/vehicles/{plate}/maintenance"
    ]
  },
  "reads": [
    "POST /api/v2/vehicles/search",
    "POST /api/v2/drivers/search",
    "POST /api/v2/trips/totals",
    "POST /api/v2/virtual-odometer",
    "POST /api/v2/diagnostics",
    "POST /api/v2/diagnostics/history",
    "POST /api/v2/reports/bi/{daily|periodic|idle_percentage}/{drivers|vehicles}",
    "POST /api/v2/reports/{events-report|engine-and-switch-activity|speed-report|full-report|diagnostics-report|heat-map}",
    "POST /api/v2/safety/{vehicles|drivers|totals|periodic}",
    "POST /api/v2/safety/ubi/{vehicles|drivers}"
  ],
  "writes": [
    {
      "match": "* /api/v1/oauth/{path...}",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/commands/{path...}",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/vehicles/{plate}/share-drive",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/drive-permission-group",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/drive-permission-group/{path...}",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/users/{path...}",
      "decide": "deny"
    },
    {
      "match": "* /api/v2/app/{path...}",
      "decide": "deny"
    },
    {
      "match": "* *",
      "decide": "deny"
    }
  ],
  "forbidden": "entitlement",
  "compose": {
    "parts": ["username", "password"],
    "value": "{username} {password}",
    "part_pattern": "^[\\x21-\\x7e]{1,256}$"
  },
  "variable": "ITURAN_TOKEN"
}
